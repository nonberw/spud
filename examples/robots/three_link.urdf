<?xml version="1.0"?>
<!-- A 3-dof toy arm: base yaw, shoulder pitch, elbow pitch. No motors here on purpose:
     SPUD adds position servos to every joint when a robot file has none.
     MuJoCo's URDF importer keeps <collision> geometry and drops <visual>, so the shapes are collisions. -->
<robot name="three_link">
  <link name="base">
    <inertial><mass value="2.0"/><inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 0.04"/><geometry><cylinder radius="0.08" length="0.08"/></geometry></visual>
    <collision><origin xyz="0 0 0.04"/><geometry><cylinder radius="0.08" length="0.08"/></geometry></collision>
  </link>
  <link name="link1">
    <inertial><origin xyz="0 0 0.05"/><mass value="0.5"/><inertia ixx="0.002" iyy="0.002" izz="0.002" ixy="0" ixz="0" iyz="0"/></inertial>
    <collision><origin xyz="0 0 0.05"/><geometry><cylinder radius="0.04" length="0.1"/></geometry></collision>
  </link>
  <link name="link2">
    <inertial><origin xyz="0 0 0.15"/><mass value="0.4"/><inertia ixx="0.003" iyy="0.003" izz="0.0005" ixy="0" ixz="0" iyz="0"/></inertial>
    <collision><origin xyz="0 0 0.15"/><geometry><cylinder radius="0.025" length="0.3"/></geometry></collision>
  </link>
  <link name="link3">
    <inertial><origin xyz="0 0 0.125"/><mass value="0.3"/><inertia ixx="0.002" iyy="0.002" izz="0.0003" ixy="0" ixz="0" iyz="0"/></inertial>
    <collision><origin xyz="0 0 0.125"/><geometry><cylinder radius="0.02" length="0.25"/></geometry></collision>
  </link>
  <joint name="yaw" type="revolute">
    <parent link="base"/><child link="link1"/><origin xyz="0 0 0.08"/><axis xyz="0 0 1"/>
    <limit lower="-2.8" upper="2.8" effort="10" velocity="3"/>
  </joint>
  <joint name="shoulder" type="revolute">
    <parent link="link1"/><child link="link2"/><origin xyz="0 0 0.1"/><axis xyz="0 1 0"/>
    <limit lower="-1.6" upper="1.6" effort="10" velocity="3"/>
  </joint>
  <joint name="elbow" type="revolute">
    <parent link="link2"/><child link="link3"/><origin xyz="0 0 0.3"/><axis xyz="0 1 0"/>
    <limit lower="-2.4" upper="2.4" effort="10" velocity="3"/>
  </joint>
</robot>
